#: includes/class-dgw-admin.php:655
msgid "Campaign on"
msgstr "Campaña encendida"

#: includes/class-dgw-admin.php:656
msgid "When it is on, it applies within its dates. You can save it off and turn it on later."
msgstr "Cuando está encendida, se aplica dentro de sus fechas. Puedes guardarla apagada y encenderla después."

#: includes/class-dgw-admin.php:663
msgid "Products"
msgstr "Productos"

#: includes/class-dgw-admin.php:664
msgid "Variations follow the categories of their parent product."
msgstr "Las variaciones siguen las categorías de su producto principal."

#: includes/class-dgw-admin.php:666
msgid "Campaign scope"
msgstr "Alcance de la campaña"

#: includes/class-dgw-admin.php:671
msgid "Every product, except the excluded categories."
msgstr "Todos los productos, excepto las categorías excluidas."

#: includes/class-dgw-admin.php:677
msgid "Selected categories"
msgstr "Categorías seleccionadas"

#: includes/class-dgw-admin.php:678
msgid "Only products in the categories you choose."
msgstr "Solo los productos de las categorías que elijas."

#: includes/class-dgw-admin.php:684
msgid "Included categories"
msgstr "Categorías incluidas"

#: includes/class-dgw-admin.php:688
msgid "Choose at least one category."
msgstr "Elige al menos una categoría."

#: includes/class-dgw-admin.php:690
msgid "Products in any of these categories or their subcategories get the discount."
msgstr "Los productos de cualquiera de estas categorías o sus subcategorías reciben el descuento."

#: includes/class-dgw-admin.php:694
msgid "Excluded categories"
msgstr "Categorías excluidas"

#: includes/class-dgw-admin.php:694
#: includes/class-dgw-admin.php:711
#: includes/class-dgw-admin.php:716
msgid "Optional"
msgstr "Opcional"

#: includes/class-dgw-admin.php:696
msgid "Products in these categories never get the discount, even if they are also in an included category."
msgstr "Los productos de estas categorías nunca reciben el descuento, aunque también estén en una categoría incluida."

#. translators: %s: WordPress timezone name.
#: includes/class-dgw-admin.php:706
#, php-format
msgid "Dates use the store timezone: %s."
msgstr "Las fechas usan la zona horaria de la tienda: %s."

#: includes/class-dgw-admin.php:711
msgid "Start"
msgstr "Inicio"

#: includes/class-dgw-admin.php:713
msgid "Empty: starts as soon as the campaign is on."
msgstr "Vacía: empieza en cuanto la campaña esté encendida."

#: includes/class-dgw-admin.php:716
msgid "End"
msgstr "Fin"

#: includes/class-dgw-admin.php:718
msgid "Empty: runs until you turn it off."
msgstr "Vacía: sigue activa hasta que la apagues."

#: includes/class-dgw-admin.php:724
msgid "Create campaign"
msgstr "Crear campaña"

#: includes/class-dgw-admin.php:724
msgid "Save changes"
msgstr "Guardar cambios"

#: includes/class-dgw-admin.php:725
msgid "Cancel"
msgstr "Cancelar"

#: includes/class-dgw-admin.php:726
msgid "Saved product prices never change."
msgstr "Los precios guardados de los productos nunca cambian."

#: includes/class-dgw-admin.php:733
#: includes/class-dgw-admin.php:740
msgid "Delete campaign"
msgstr "Eliminar campaña"

#: includes/class-dgw-admin.php:734
msgid "Removes this campaign from the list. Product prices are not affected."
msgstr "Quita esta campaña de la lista. Los precios de los productos no se ven afectados."

#: includes/class-dgw-admin.php:765
msgid "On · ended"
msgstr "Encendida · finalizada"

