#, php-format
msgid "except %s"
msgstr "excepto %s"

#: includes/class-dgw-admin.php:302
msgid "You do not have permission to manage discount campaigns."
msgstr "No tienes permisos para administrar campañas de descuento."

#: includes/class-dgw-admin.php:347
msgid "Dismiss message"
msgstr "Cerrar mensaje"

#: includes/class-dgw-admin.php:395
msgid "No dates: runs while it is on"
msgstr "Sin fechas: se aplica mientras esté encendida"

#: includes/class-dgw-admin.php:399
msgid "When turned on"
msgstr "Al encenderla"

#: includes/class-dgw-admin.php:400
msgid "No end date"
msgstr "Sin fecha final"

#. translators: %s: human time difference, e.g. "3 days".
#: includes/class-dgw-admin.php:406
#, php-format
msgid "Starts in %s"
msgstr "Empieza en %s"

#. translators: %s: human time difference, e.g. "3 days".
#: includes/class-dgw-admin.php:409
#, php-format
msgid "Ends in %s"
msgstr "Termina en %s"

#. translators: %s: human time difference, e.g. "3 days".
#: includes/class-dgw-admin.php:412
#, php-format
msgid "Ended %s ago"
msgstr "Terminó hace %s"

#. translators: %d: percentage of the campaign period that has elapsed.
#: includes/class-dgw-admin.php:421
#, php-format
msgid "%d%% of the campaign period has elapsed"
msgstr "Ha transcurrido el %d%% del periodo de la campaña"

#: includes/class-dgw-admin.php:442
msgid "Schedule percentage discounts for the whole store or selected categories. Saved product prices never change."
msgstr "Programa descuentos porcentuales para toda la tienda o para categorías concretas. Los precios guardados de los productos nunca cambian."

#: includes/class-dgw-admin.php:446
#: includes/class-dgw-admin.php:619
msgid "New campaign"
msgstr "Nueva campaña"

#: includes/class-dgw-admin.php:458
msgid "No campaigns yet"
msgstr "Aún no hay campañas"

#: includes/class-dgw-admin.php:459
msgid "A campaign sets a discount, the products it covers and when it runs. You can prepare it now and turn it on later."
msgstr "Una campaña define un descuento, los productos que cubre y cuándo se aplica. Puedes prepararla ahora y encenderla después."

#: includes/class-dgw-admin.php:460
msgid "Create your first campaign"
msgstr "Crea tu primera campaña"

#: includes/class-dgw-admin.php:470
msgid "When several active campaigns include the same product, the biggest discount applies. While a campaign runs, it replaces the product's own sale price."
msgstr "Cuando varias campañas activas incluyen el mismo producto, se aplica el mayor descuento. Mientras una campaña está activa, reemplaza el precio de oferta propio del producto."

