#. Plugin Name of the plugin
#: descuento-global-woo.php
msgid "Descuento Global Woo"
msgstr "Descuento Global Woo"

#. Description of the plugin
#: descuento-global-woo.php
msgid "Schedules store-wide or category discount campaigns without changing the prices saved in WooCommerce."
msgstr "Programa campañas de descuento para toda la tienda o por categorías sin modificar los precios guardados de WooCommerce."

#. Author of the plugin
#: descuento-global-woo.php
msgid "Mauricio Correa"
msgstr "Mauricio Correa"

#. Author URI of the plugin
#: descuento-global-woo.php
msgid "https://maurouix.com/"
msgstr "https://maurouix.com/"

#: descuento-global-woo.php:48
msgid "Descuento Global Woo requires WooCommerce to be installed and active."
msgstr "Descuento Global Woo necesita que WooCommerce esté instalado y activo."

#: includes/class-dgw-admin.php:106
#: includes/class-dgw-admin.php:107
#: includes/class-dgw-admin.php:441
#: includes/class-dgw-admin.php:474
msgid "Discount campaigns"
msgstr "Campañas de descuento"

#: includes/class-dgw-admin.php:131
msgid "Active"
msgstr "Activa"

#: includes/class-dgw-admin.php:132
msgid "Scheduled"
msgstr "Programada"

#: includes/class-dgw-admin.php:133
#: includes/class-dgw-admin.php:762
msgid "Off"
msgstr "Apagada"

#: includes/class-dgw-admin.php:134
msgid "Ended"
msgstr "Finalizada"

#: includes/class-dgw-admin.php:146
msgid "Campaign created"
msgstr "Campaña creada"

#: includes/class-dgw-admin.php:146
msgid "It applies according to its switch and dates."
msgstr "Se aplica según su interruptor y sus fechas."

#: includes/class-dgw-admin.php:147
msgid "Campaign saved"
msgstr "Campaña guardada"

#: includes/class-dgw-admin.php:147
msgid "Prices in the store are already up to date."
msgstr "Los precios de la tienda ya están actualizados."

#: includes/class-dgw-admin.php:148
msgid "Campaign turned on"
msgstr "Campaña encendida"

#: includes/class-dgw-admin.php:148
msgid "It applies within its dates."
msgstr "Se aplica dentro de sus fechas."

#: includes/class-dgw-admin.php:149
msgid "Campaign turned off"
msgstr "Campaña apagada"

#: includes/class-dgw-admin.php:149
msgid "Its products are back to their usual prices."
msgstr "Sus productos vuelven a su precio habitual."

#: includes/class-dgw-admin.php:150
msgid "Campaign duplicated"
msgstr "Campaña duplicada"

#: includes/class-dgw-admin.php:150
msgid "The copy is off. Review it and turn it on when it is ready."
msgstr "La copia está apagada. Revísala y enciéndela cuando esté lista."

#: includes/class-dgw-admin.php:151
msgid "Campaign deleted"
msgstr "Campaña eliminada"

#: includes/class-dgw-admin.php:151
msgid "Product prices are not affected."
msgstr "Los precios de los productos no se ven afectados."

#: includes/class-dgw-admin.php:152
msgid "Campaign not found"
msgstr "No encontramos la campaña"

#: includes/class-dgw-admin.php:152
msgid "It may have been deleted. Choose another campaign from the list."
msgstr "Puede que se haya eliminado. Elige otra campaña de la lista."

#: includes/class-dgw-admin.php:153
msgid "Name the campaign"
msgstr "Ponle nombre a la campaña"

#: includes/class-dgw-admin.php:153
msgid "A name helps you find it in the list, for example \"Black Friday 2026\"."
msgstr "Un nombre te ayuda a encontrarla en la lista, por ejemplo \"Black Friday 2026\"."

#: includes/class-dgw-admin.php:154
msgid "Invalid percentage"
msgstr "Porcentaje no válido"

#: includes/class-dgw-admin.php:154
msgid "Enter a percentage between 0.01 and 100."
msgstr "Introduce un porcentaje entre 0,01 y 100."

#: includes/class-dgw-admin.php:155
msgid "We could not read the dates"
msgstr "No pudimos leer las fechas"

#: includes/class-dgw-admin.php:155
msgid "Check the dates and times you entered and try again."
msgstr "Revisa las fechas y horas introducidas e inténtalo nuevamente."

#: includes/class-dgw-admin.php:156
msgid "The date range is not valid"
msgstr "El intervalo no es válido"

#: includes/class-dgw-admin.php:156
msgid "The end date must be later than the start date."
msgstr "La fecha final debe ser posterior a la fecha inicial."

#: includes/class-dgw-admin.php:157
msgid "Choose at least one category"
msgstr "Elige al menos una categoría"

#: includes/class-dgw-admin.php:157
msgid "To limit the campaign to categories, select the categories it applies to."
msgstr "Para limitar la campaña a categorías, selecciona las categorías a las que se aplica."

#. translators: compact date format for the campaign list, see https://www.php.net/manual/datetime.format.php
#: includes/class-dgw-admin.php:216
msgctxt "campaign list date"
msgid "M j, Y"
msgstr "j M Y"

#: includes/class-dgw-admin.php:251
